# Backend base URL used by Axios.
# - Leave EMPTY in dev (Vite proxy /api -> VITE_DEV_API_TARGET handles it)
# - In production, set to absolute URL of the NestJS API including /api suffix:
#     VITE_API_BASE_URL=https://api.fieldly.example.com/api
VITE_API_BASE_URL=

# Where Vite dev server proxies /api, /uploads and /socket.io.
# Default is the local NestJS backend_pim instance.
VITE_DEV_API_TARGET=http://localhost:3000
